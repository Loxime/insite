<!DOCTYPE html>
<html lang="fr">
<head>
    {% include 'layout/_favicon.html.twig' %}
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>{% block title %}Administration — INQUEST{% endblock %}</title>

    {{ reprise_entry_link_tags('app') }}
    {{ reprise_entry_script_tags('app') }}
</head>

<body class="admin">
    {# Une seule source de verite pour les rubriques et leurs onglets. #}
    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set staffItems = [] %}
    {% if is_granted('ROLE_SUPER_ADMIN') %}
        {% set staffItems = [{label: 'Administrateurs', route: 'admin_users_index', prefix: 'admin_users_'}] %}
    {% endif %}
    {% set staffItems = staffItems|merge([
        {label: "Membres de l'équipe", route: 'admin_about_profiles_index', prefix: 'admin_about_profiles_'}
    ]) %}
    {% set sections = [
        {id: 'studios', label: 'Studios', icon: 'fa-clapperboard', items: [
            {label: 'Blog', route: 'admin_blog_index', prefix: 'admin_blog_'},
            {label: 'Games', route: 'admin_games_index', prefix: 'admin_games_'},
            {label: 'About', route: 'admin_about_edit', prefix: 'admin_about_edit'},
            {label: 'Changelog', route: 'admin_changelog_index', prefix: 'admin_changelog_'},
            {label: 'Tags', route: 'admin_tags_index', prefix: 'admin_tags_'}
        ]},
        {id: 'community', label: 'Community', icon: 'fa-users', items: [
            {label: 'Annonces', route: 'admin_announcements_index', prefix: 'admin_announcements_'},
            {label: 'FAQ', route: 'admin_faq_index', prefix: 'admin_faq_'},
            {label: 'Careers', route: 'admin_careers_index', prefix: 'admin_careers_'},
            {label: 'Jam', route: 'admin_challenges_index', prefix: 'admin_challenges_'}
        ]},
        {id: 'staff', label: 'Staff', icon: 'fa-user-shield', items: staffItems}
    ] %}
    {% set activeSection = null %}
    {% for section in sections %}
        {% for item in section.items %}
            {% if currentRoute starts with item.prefix %}
                {% set activeSection = section %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% include 'layout/_toasts.html.twig' %}
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar__top">
                <a
                    href="{{ path('admin') }}"
                    class="admin-sidebar__brand"
                    aria-label="Administration INQUEST"
                >
                    <img
                        src="{{ asset('images/crown-removebg-preview.png') }}"
                        alt=""
                        class="site-brand__logo admin-sidebar__logo"
                    >
                </a>

                <nav class="admin-sidebar__navigation" aria-label="Navigation administration">
                    {% for section in sections %}
                        <a
                            href="{{ path(section.items[0].route) }}"
                            class="admin-sidebar__link{{ activeSection and activeSection.id == section.id ? ' is-active' : '' }}"
                            {% if activeSection and activeSection.id == section.id %}aria-current="page"{% endif %}
                        >
                            <i class="fa-solid {{ section.icon }}" aria-hidden="true"></i>
                            <span>{{ section.label }}</span>
                        </a>
                    {% endfor %}
                    <a
                        href="{{ path('admin_site_edit') }}"
                        class="admin-sidebar__link{{ currentRoute starts with 'admin_site_' ? ' is-active' : '' }}"
                    >
                        <i class="fa-solid fa-gear" aria-hidden="true"></i>
                        <span>Site</span>
                    </a>
                </nav>
            </div>

            <div class="admin-sidebar__bottom">
                <div class="admin-sidebar__user">{{ app.user.userIdentifier }}</div>
                <div class="admin-sidebar__quick-actions">
                    <a href="{{ path('app_frontoffice_home_show') }}"
                       class="admin-sidebar__icon-button"
                       aria-label="Retour au site" title="Retour au site">
                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    </a>
                    <a href="{{ path('admin_logout') }}"
                       class="admin-sidebar__icon-button"
                       aria-label="Déconnexion" title="Déconnexion">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </aside>

        <main class="admin-content">
            {% if activeSection %}
                <nav class="admin-section-tabs" aria-label="Rubriques {{ activeSection.label }}">
                    {% for item in activeSection.items %}
                        <a
                            href="{{ path(item.route) }}"
                            class="admin-section-tabs__link{{ currentRoute starts with item.prefix ? ' is-active' : '' }}"
                            {% if currentRoute starts with item.prefix %}aria-current="page"{% endif %}
                        >{{ item.label }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
            {% block body %}{% endblock %}
        </main>
    </div>
</body>
</html>
