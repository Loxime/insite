{% extends 'admin/base.html.twig' %}

{% block title %}Annonces — Administration{% endblock %}

{% block body %}
<div class="admin-page">
    <header class="admin-page__header admin-page__header--actions">
        <h1 class="admin-page__title">Annonces</h1>

        <a href="{{ path('admin_announcements_new') }}"
           class="admin-button admin-button--primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Créer
        </a>
    </header>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="admin-flash admin-flash--{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <form method="get"
          action="{{ path('admin_announcements_index') }}"
          class="admin-search">
        <label for="announcement-search" class="admin-search__label">
            Rechercher
        </label>

        <div class="admin-search__row">
            <input type="search"
                   id="announcement-search"
                   name="q"
                   value="{{ search }}"
                   placeholder="Rechercher une annonce..."
                   class="admin-search__input">

            <button class="admin-button admin-button--primary"
                    type="submit">
                Rechercher
            </button>

            {% if search %}
                <a href="{{ path('admin_announcements_index') }}"
                   class="admin-button admin-button--secondary">
                    Réinitialiser
                </a>
            {% endif %}
        </div>
    </form>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Contenu</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Statut</th>
                    <th class="admin-table__actions-heading">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for announcement in announcements %}
                    <tr>
                        <td>
                            <strong>
                                {{ announcement.type == 'banner'
                                    ? 'Banner'
                                    : 'Popup' }}
                            </strong>
                        </td>

                        <td>
                            {% if announcement.type == 'banner' %}
                                <strong>{{ announcement.bannerText ?: '—' }}</strong>
                            {% else %}
                                {% if announcement.imageKey %}
                                    <img
                                        class="admin-announcement-thumbnail"
                                        src="{{ path('media_show', {
                                            key: announcement.imageKey
                                        }) }}"
                                        alt="Aperçu de l’annonce"
                                        width="104"
                                        height="64"
                                        loading="lazy">
                                {% endif %}

                                <strong>
                                    {{ announcement.buttonLabel ?: '—' }}
                                </strong>
                            {% endif %}

                            <small class="admin-announcement-list__detail">
                                {{ announcement.buttonUrl }}
                            </small>
                        </td>

                        <td>
                            {{ announcement.startsAt
                                ? announcement.startsAt|date('d/m/Y H:i', 'Europe/Paris')
                                : 'Immédiat' }}
                        </td>

                        <td>
                            {{ announcement.endsAt
                                ? announcement.endsAt|date('d/m/Y H:i', 'Europe/Paris')
                                : 'Sans échéance' }}
                        </td>

                        <td>
                            {% if not announcement.enabled %}
                                <span class="admin-status admin-status--draft">
                                    Désactivée
                                </span>
                            {% elseif announcement.type == 'banner'
                                and not announcement.bannerText %}
                                <span class="admin-status admin-status--draft">
                                    Texte manquant
                                </span>
                            {% elseif announcement.type == 'popup'
                                and not announcement.imageKey %}
                                <span class="admin-status admin-status--draft">
                                    Image manquante
                                </span>
                            {% elseif announcement.startsAt
                                and announcement.startsAt > date() %}
                                <span class="admin-status admin-status--draft">
                                    Programmée
                                </span>
                            {% elseif announcement.endsAt
                                and announcement.endsAt <= date() %}
                                <span class="admin-status admin-status--archived">
                                    Terminée
                                </span>
                            {% else %}
                                <span class="admin-status admin-status--published">
                                    Active
                                </span>
                            {% endif %}
                        </td>

                        <td>
                            <div class="admin-table__actions">
                                <a href="{{ path('admin_announcements_edit', {
                                    id: announcement.id
                                }) }}"
                                   class="admin-action"
                                   aria-label="Modifier"
                                   title="Modifier">
                                    <i class="fa-solid fa-pen"
                                       aria-hidden="true"></i>
                                </a>

                                <form method="post"
                                      action="{{ path('admin_announcements_delete', {
                                          id: announcement.id
                                      }) }}"
                                      class="js-announcement-delete">
                                    <input type="hidden"
                                           name="_token"
                                           value="{{ csrf_token(
                                               'delete-announcement-' ~ announcement.id
                                           ) }}">

                                    <button type="submit"
                                            class="admin-action admin-action--danger"
                                            aria-label="Supprimer"
                                            title="Supprimer">
                                        <i class="fa-solid fa-trash"
                                           aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="admin-table__empty">
                            Aucune annonce trouvée.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if announcements.pageCount > 1 %}
        <nav class="admin-pagination"
             aria-label="Pagination des annonces">
            {{ knp_pagination_render(announcements) }}
        </nav>
    {% endif %}
</div>
{% endblock %}
