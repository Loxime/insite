{% extends 'admin/base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<div class="admin-page">
    <h1 class="admin-page__title">
        Réinitialiser le mot de passe
    </h1>

    <p>{{ user.email }}</p>

    {{ form_start(form, {attr: {class: 'admin-simple-form'}}) }}
        {{ form_widget(form) }}

        <button class="admin-button admin-button--primary">
            Enregistrer
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
