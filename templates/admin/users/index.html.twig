{% extends 'admin/base.html.twig' %}

{% block title %}Administrateurs{% endblock %}

{% block body %}
<div class="admin-page">
    <header class="admin-page__header admin-page__header--actions">
        <h1 class="admin-page__title">
            Administrateurs
        </h1>

        <a href="{{ path('admin_users_new') }}"
           class="admin-button admin-button--primary">
            Créer un administrateur
        </a>
    </header>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Rôle</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.email }}</td>
                    <td>{{ user.username ?: '—' }}</td>
                    <td>{{ user.role }}</td>
                    <td>
                        <a class="admin-action"
                           href="{{ path('admin_users_password', {id: user.id}) }}">
                            Forcer un mot de passe
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
