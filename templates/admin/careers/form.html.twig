{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }} — Administration{% endblock %}

{% block body %}
<div class="admin-page">
    <h1 class="admin-page__title">{{ title }}</h1>

    {{ form_start(form, {attr: {class: 'admin-simple-form'}}) }}
        {{ form_row(form.title) }}
        {{ form_row(form.content) }}

        <div class="admin-form-row">
            {{ form_row(form.displayOrder) }}
            {{ form_row(form.enabled) }}
        </div>

        <div class="admin-form-actions">
            <button class="admin-button admin-button--primary">
                Enregistrer
            </button>

            <a href="{{ path('admin_careers_index') }}"
               class="admin-button admin-button--secondary">
                Annuler
            </a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
