{% extends 'admin/base.html.twig' %}

{% block title %}Careers — Administration{% endblock %}

{% block body %}
<div class="admin-page">
    <header class="admin-page__header admin-page__header--actions">
        <h1 class="admin-page__title">Careers</h1>

        <a href="{{ path('admin_careers_new') }}"
           class="admin-button admin-button--primary">
            Ajouter une offre
        </a>
    </header>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Ordre</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for offer in offers %}
                <tr>
                    <td>{{ offer.title }}</td>
                    <td>{{ offer.displayOrder }}</td>
                    <td>{{ offer.enabled ? 'Oui' : 'Non' }}</td>
                    <td>
                        <div class="admin-table__actions">
                            <a class="admin-action"
                               href="{{ path('admin_careers_edit', {id: offer.id}) }}" aria-label="Modifier" title="Modifier">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </a>

                            <form method="post"
                                  action="{{ path('admin_careers_delete', {id: offer.id}) }}">
                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('delete-career-' ~ offer.id) }}">

                                <button type="submit"
                                        class="admin-action admin-action--danger" aria-label="Supprimer" title="Supprimer">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucune offre.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
