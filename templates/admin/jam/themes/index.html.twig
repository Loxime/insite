{% extends 'admin/base.html.twig' %}

{% block title %}Thèmes de Jam{% endblock %}

{% block body %}
<div class="admin-page">
    <header class="admin-page__header admin-page__header--actions">
        <h1 class="admin-page__title">
            Thèmes de Jam
        </h1>

        <div class="admin-form-actions">
            <a
                href="{{ path('admin_jam_index') }}"
                class="admin-button admin-button--secondary"
            >
                Retour aux Jams
            </a>

            <a
                href="{{ path('admin_jam_themes_new') }}"
                class="admin-button admin-button--primary"
            >
                Nouveau thème
            </a>
        </div>
    </header>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Thème</th>
                    <th>Aléatoire</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for theme in themes %}
                    <tr>
                        <td>{{ theme.name }}</td>

                        <td>
                            {{ theme.enabled ? 'Actif' : 'Désactivé' }}
                        </td>

                        <td>
                            <div class="admin-table__actions">
                                <a
                                    href="{{ path(
                                        'admin_jam_themes_edit',
                                        {id: theme.id}
                                    ) }}"
                                    class="admin-action"
                                 aria-label="Modifier" title="Modifier">
                                    <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                </a>

                                <form
                                    method="post"
                                    action="{{ path(
                                        'admin_jam_themes_delete',
                                        {id: theme.id}
                                    ) }}"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token(
                                            'delete-jam-theme-' ~ theme.id
                                        ) }}"
                                    >

                                    <button
                                        class="admin-action admin-action--danger"
                                        type="submit"
                                     aria-label="Supprimer" title="Supprimer">
                                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">
                            Aucun thème.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
