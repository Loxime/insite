---
import { getEntry } from 'astro:content';

import GameLayout from '../layouts/GameLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Stores from '../components/sections/Stores.astro';
import Packs from '../components/sections/Packs.astro';
import Gallery from '../components/sections/Gallery.astro';
import Press from '../components/sections/Press.astro';
import Team from '../components/sections/Team.astro';
import Footer from '../components/sections/Footer.astro';

const entry = await getEntry('game', 'page');

if (!entry) {
  throw new Error(
    'Le fichier src/content/game/page.yaml est obligatoire.',
  );
}

const game = entry.data;
---

<GameLayout game={game}>
  <Hero game={game} />

  <Features features={game.features} />

  <Stores stores={game.stores} />

  {game.packs && game.packs.length > 0 && (
    <Packs packs={game.packs} />
  )}

  {game.gallery && game.gallery.length > 0 && (
    <Gallery gallery={game.gallery} />
  )}

  {game.press && game.press.length > 0 && (
    <Press press={game.press} />
  )}

  {game.team && game.team.length > 0 && (
    <Team team={game.team} />
  )}
  <Footer slot="footer" game={game} />
</GameLayout>
