---
import type { CollectionEntry } from 'astro:content';

import '../../styles/footer.css';

interface Props {
  game: CollectionEntry<'game'>['data'];
}

const { game } = Astro.props;

const links = [
  {
    label: 'Découvrir',
    href: '#features',
    visible: true,
  },
  {
    label: 'Boutiques',
    href: '#stores',
    visible: true,
  },
  {
    label: 'Packs',
    href: '#packs',
    visible: Boolean(game.packs?.length),
  },
  {
    label: 'Galerie',
    href: '#gallery',
    visible: Boolean(game.gallery?.length),
  },
  {
    label: 'Presse',
    href: '#press',
    visible: Boolean(game.press?.length),
  },
  {
    label: 'Équipe',
    href: '#team',
    visible: Boolean(game.team?.length),
  },
].filter((link) => link.visible);
---

<footer class="game-footer">
  <div class="content-shell">

    <div class="game-footer__top">

      <div class="game-footer__identity">
        <p class="game-footer__name">
          {game.title}
        </p>

        <p class="game-footer__tagline">
          {game.hero.tagline}
        </p>
      </div>

      <nav
        class="game-footer__navigation"
        aria-label="Navigation de pied de page"
      >
        <p class="game-footer__heading">
          Navigation
        </p>

        <ul>
          {links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

    <div class="game-footer__bottom">

      <small class="game-footer__copyright">
        © {new Date().getFullYear()} {game.title}
      </small>

      <nav
        class="game-footer__socials"
        aria-label="Réseaux sociaux et liens officiels"
      >
        <ul>
          {game.socials.map((social) => (
            <li>
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.network} (nouvel onglet)`}
              >
                {social.network}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

  </div>
</footer>
