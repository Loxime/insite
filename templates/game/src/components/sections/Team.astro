---
import type { CollectionEntry } from 'astro:content';

import '../../styles/team.css';

interface Props {
  team: NonNullable<CollectionEntry<'game'>['data']['team']>;
}

const { team } = Astro.props;
---

<section
  id="team"
  class="game-section game-team"
  aria-labelledby="team-heading"
>
  <div class="content-shell">
    <header class="game-team__heading">
      <h2 id="team-heading">Derrière le jeu</h2>
      <p>
        Découvrez les personnes et les studios
        qui donnent vie à cette aventure.
      </p>
    </header>

    <ul class="game-team__grid">
      {team.map((member) => (
        <li class="game-team__item">
          <article class="game-team__card">
            <h3>{member.name}</h3>

            <p class="game-team__role">
              {member.role}
            </p>

            {member.bio && (
              <p class="game-team__bio">
                {member.bio}
              </p>
            )}
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
