---
import type { CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';

interface Props {
  game: CollectionEntry<'game'>['data'];
}

const { game } = Astro.props;
---

<section class="game-hero" aria-labelledby="game-title">
  <div class="game-hero__media">
    <Picture
      src={game.hero.image}
      formats={['avif', 'webp']}
      widths={[480, 768, 1200]}
      sizes="100vw"
      alt={game.hero.imageAlt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="game-hero__content">
    <div class="game-hero__logo">
      <Image
        src={game.hero.logo}
        format="webp"
        widths={[240, 360, 500]}
        sizes="(max-width: 640px) 75vw, 440px"
        alt={game.hero.logoAlt}
        loading="eager"
        decoding="async"
      />
    </div>

    <h1 id="game-title">{game.title}</h1>

    <p class="game-hero__tagline">
      {game.hero.tagline}
    </p>

    <div class="game-hero__actions">
      <a href="#stores" class="game-button game-button--primary">
        Découvrir les boutiques
      </a>

      <a href="#features" class="game-button">
        Explorer le jeu
      </a>
    </div>
  </div>
</section>
