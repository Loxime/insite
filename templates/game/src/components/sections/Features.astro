---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

import '../../styles/features.css';

interface Props {
  features: CollectionEntry<'game'>['data']['features'];
}

const { features } = Astro.props;
---

<section
  id="features"
  class="game-section game-features"
  aria-labelledby="features-heading"
>
  <div class="content-shell">
    <header class="game-features__heading">
      <h2 id="features-heading">Découvrez l'aventure</h2>
    </header>

    <div class="game-features__list">
      {features.map((feature) => (
        <article class="game-feature">

          <div class="game-feature__media">
            <Picture
              src={feature.image}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) 100vw, 50vw"
              alt={feature.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="game-feature__content">
            <h3>{feature.title}</h3>

            <p>{feature.body}</p>

            {feature.bullets && feature.bullets.length > 0 && (
              <ul class="game-feature__bullets">
                {feature.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>

        </article>
      ))}
    </div>
  </div>
</section>
