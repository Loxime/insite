---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

import '../../styles/gallery.css';

interface Props {
  gallery: NonNullable<CollectionEntry<'game'>['data']['gallery']>;
}

const { gallery } = Astro.props;
---

<section
  id="gallery"
  class="game-section game-gallery"
  aria-labelledby="gallery-heading"
>
  <div class="content-shell">
    <header class="game-gallery__heading">
      <h2 id="gallery-heading">Galerie du jeu</h2>
      <p>Découvrez quelques images de l'aventure.</p>
    </header>

    <div
      class="game-gallery__scroller"
      role="region"
      aria-label="Captures d'écran, défilement horizontal"
      tabindex="0"
    >
      <ul class="game-gallery__track">
        {gallery.map((item) => (
          <li class="game-gallery__item">
            <figure class="game-gallery__figure">
              <Picture
                src={item.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                widths={[480, 800, 1200]}
                sizes="(max-width: 760px) 80vw, 760px"
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </li>
        ))}
      </ul>
    </div>

    <p class="game-gallery__hint">
      Faites défiler horizontalement pour voir les autres images.
    </p>
  </div>
</section>
