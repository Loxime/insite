---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

import '../../styles/packs.css';

interface Props {
  packs: NonNullable<CollectionEntry<'game'>['data']['packs']>;
}

const { packs } = Astro.props;
---

<section
  id="packs"
  class="game-section game-packs"
  aria-labelledby="packs-heading"
>
  <div class="content-shell">
    <header class="game-packs__heading">
      <h2 id="packs-heading">Prolongez l'aventure</h2>
      <p>
        Découvrez les contenus additionnels
        disponibles autour du jeu.
      </p>
    </header>

    <ul class="game-packs__grid">
      {packs.map((pack) => (
        <li class="game-pack">
          <article class="game-pack__card">
            <div class="game-pack__media">
              <Picture
                src={pack.image}
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                widths={[360, 600, 900]}
                sizes="(max-width: 640px) calc(100vw - 40px), 340px"
                alt={pack.imageAlt}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="game-pack__content">
              <h3>{pack.name}</h3>
              <p>{pack.blurb}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
