{% extends 'base.html.twig' %}

{% block title %}
    {{ post.title }} — INQUEST
{% endblock %}

{% block meta_description %}
    {{ post.title }}
{% endblock %}

{% block page_header %}{% endblock %}

{% block body %}
    <article class="blog-article">
        <header class="blog-article__header">
            <div class="blog-article__meta">
                {% for tag in post.tags %}
                    <span class="blog-article__tag">
                        {{ tag.libelle }}
                    </span>
                {% endfor %}

                <time
                    datetime="{{ post.createdAt|date('c') }}"
                    class="blog-article__date"
                >
                    {{ post.createdAt|date('d/m/Y') }}
                </time>
            </div>

            <h1 class="blog-article__title">
                {{ post.title }}
            </h1>
        </header>

        {% if post.imageKey %}
            <figure class="blog-article__image">
                <img
                    src="{{ path('media_show', {key: post.imageKey}) }}"
                    alt="{{ post.title }}"
                >
            </figure>
        {% endif %}

        <div class="blog-article__content">
            {{ post.content|raw }}
        </div>

        <footer class="blog-article__author">
            Par {{ post.author.username ?: 'Auteur' }}
        </footer>
    </article>
{% endblock %}
